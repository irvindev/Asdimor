# Plantilla para producción.
# En local: copia este archivo como ".env.production" (sin ".example") si necesitas compilar
# un build de producción a mano. ".env.production" NO se sube a git (ver .gitignore).
# En GitHub Actions: estos valores se inyectan desde los Secrets del repo/entorno, este
# archivo es solo referencia de qué variables existen.

REACT_APP_BASE_URL=https://admin.asdimor.com/
REACT_APP_SITE_URL=https://asdimor.com

REACT_APP_WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REACT_APP_WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

REACT_APP_MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
REACT_APP_MP_PAYMENT_URL=https://mp.asdimor.com/api/payment

REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
