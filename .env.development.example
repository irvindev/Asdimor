# Plantilla para desarrollo local.
# Copia este archivo como ".env.development" (sin ".example") y coloca tus valores reales.
# ".env.development" NO se sube a git (ver .gitignore).

REACT_APP_BASE_URL=https://admin.asdimor.com/
REACT_APP_SITE_URL=http://localhost:3000

# Credenciales de la API REST de WooCommerce (Admin WP > WooCommerce > Ajustes > Avanzado > REST API)
# Idealmente una key distinta a la de producción, con los permisos mínimos necesarios.
REACT_APP_WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REACT_APP_WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Usa una public key de PRUEBA de Mercado Pago (empieza con "TEST-") para no procesar pagos reales en dev.
REACT_APP_MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
REACT_APP_MP_PAYMENT_URL=https://mp.asdimor.com/api/payment

# Google Maps JavaScript API key (restringida por HTTP referrer en Google Cloud Console)
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
